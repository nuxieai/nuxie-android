load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain", "kt_javac_options", "kt_kotlinc_options")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_java//toolchains:default_java_toolchain.bzl", "VANILLA_TOOLCHAIN_CONFIGURATION", "default_java_toolchain")

package(default_visibility = ["//visibility:public"])
exports_files(["runtime_artifacts.py", "host_runtime.py", "host_render_launcher.sh", "host_test_launcher.sh", "jvm_test_launcher.sh", "rules-kotlin-2.0-adapter.patch", "rules-android-min-sdk-23.patch"])

# Match the owning lint module's JDK 17 compiler, independently of the JDK 21
# used by Android tools. Newer javac emits PSI interface calls lint rejects.
default_java_toolchain(
    name = "lint_java17_toolchain",
    configuration = VANILLA_TOOLCHAIN_CONFIGURATION,
    toolchain_definition = False,
    java_runtime = "@rules_java//toolchains:remotejdk_17",
    source_version = "17",
    target_version = "17",
    bootclasspath = [],
    forcibly_disable_header_compilation = True,
    misc = ["-g", "-parameters"],
)

kt_kotlinc_options(name = "kotlinc_options", jvm_target = "17", x_jvm_default = "all")
kt_javac_options(name = "javac_options", release = "17")
define_kt_toolchain(
    name = "kotlin_toolchain",
    language_version = "2.0",
    api_version = "2.0",
    jvm_target = "17",
    kotlinc_options = ":kotlinc_options",
    javac_options = ":javac_options",
    experimental_build_tools_api = False,
    jvm_stdlibs = ["@sdk_maven//:org_jetbrains_kotlin_kotlin_stdlib", "@rules_kotlin//kotlin/compiler:annotations"],
    jvm_runtime = ["@sdk_maven//:org_jetbrains_kotlin_kotlin_stdlib"],
)

py_binary(name = "package_aar", srcs = ["package_aar.py"])
py_binary(name = "test_suite", srcs = ["test_suite.py"])
py_binary(name = "verify_host_tests", srcs = ["verify_host_tests.py"])

java_binary(
    name = "dokka_cli",
    main_class = "org.jetbrains.dokka.MainKt",
    runtime_deps = ["@docs_maven//:org_jetbrains_dokka_dokka_cli"],
)
